# Use this justfile by 
# (1) installing with "cargo install just" 
# (2) running the "just" command.

# Displays available recipes by running `just -l`.
setup:
  #!/usr/bin/env bash
  just -l

# Install all dependencies
install:
  #!/usr/bin/env bash
  set -Eeuo pipefail
  command -v bun >/dev/null 2>&1 || {
    echo "bun is required to install EVM E2E dependencies" >&2
    exit 1
  }

  if [[ ! -e .env ]]; then
    cp .env_sample .env
    echo "Created evm/e2e/.env from .env_sample"
  fi

  bun install --frozen-lockfile
  (cd passkey-sdk && bun install --frozen-lockfile)
  bunx hardhat typechain

# Runs the E2E tests
test *args:
  #!/usr/bin/env bash
  set -euo pipefail
  bun test {{args}}

# Runs tx receipt tests. Used for testnet quick check.
test-basic:
  #!/usr/bin/env bash
  set -euo pipefail
  bun test -- tx_receipt.test.ts

# Format
fmt: 
  bunx prettier --write . --config prettier.config.js

# Format (check only)
fmt-check:
  bunx prettier --check . --config prettier.config.js

gen-types:
  bunx hardhat typechain
