FROM rust:1.95.0-bookworm

# Install build dependencies
RUN apt-get update \
  && apt install -y clang llvm gcc g++ zlib1g-dev libmpc-dev libmpfr-dev libgmp-dev build-essential cmake \
  # Support for Windows cross-compile
  mingw-w64

## ADD MACOS SUPPORT

WORKDIR /opt

# Add macOS and Windows Rust targets
RUN rustup target add x86_64-apple-darwin aarch64-apple-darwin x86_64-pc-windows-gnu

# Wasmer 7's ARM64 compact-unwind registry needs the callback registration
# symbols absent from the old macOS 11.3 SDK. Pin SDK contents and osxcross.
RUN git clone https://github.com/tpoechtrager/osxcross \
  && cd osxcross \
  && git checkout 27d21e4977c9751d01199c7a226a6faf494c3dd9 \
  && wget -nc https://github.com/joseluisq/macosx-sdks/releases/download/14.5/MacOSX14.5.sdk.tar.xz \
  && echo "6e146275d19f027faa2e8354da5e0267513abf013b8f16ad65a231653a2b1c5d  MacOSX14.5.sdk.tar.xz" | sha256sum -c - \
  && mv MacOSX14.5.sdk.tar.xz tarballs/ \
  && UNATTENDED=1 BUILD_FLAVOR=stable OSX_VERSION_MIN=14.5 ./build.sh \
  && rm -r tarballs/

ENV MACOSX_DEPLOYMENT_TARGET=14.5
RUN chmod +rx /opt/osxcross
RUN chmod +rx /opt/osxcross/target
RUN chmod -R +rx /opt/osxcross/target/bin

# RUN ls -l /opt/osxcross/target/bin
RUN /opt/osxcross/target/bin/x86_64-apple-darwin23.5-clang --version
RUN /opt/osxcross/target/bin/aarch64-apple-darwin23.5-clang --version

# allow non-root user to download more deps later
RUN chmod -R 777 /usr/local/cargo

## COPY BUILD SCRIPTS

WORKDIR /code

COPY guest/*.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/*.sh

RUN mkdir /.cargo
RUN chmod +rx /.cargo
COPY guest/cargo-config /.cargo/config

CMD ["bash", "-c", "echo 'Argument missing. Pass one build script (e.g. build_macos.sh) to docker run' && exit 1"]
