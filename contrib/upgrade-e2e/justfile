# Show the isolated upgrade runner's arguments.
help:
    uv run --locked --project {{quote(justfile_directory())}} --no-dev {{quote(justfile_directory() / "run.py")}} --help

# Prepare an isolated old-binary node without starting it.
prepare *args:
    uv run --locked --project {{quote(justfile_directory())}} --no-dev {{quote(justfile_directory() / "run.py")}} prepare {{args}}

# Start and stop the isolated baseline with pinned Cosmovisor.
smoke *args:
    uv run --locked --project {{quote(justfile_directory())}} --no-dev {{quote(justfile_directory() / "run.py")}} smoke {{args}}

# Run governance upgrades with pinned baseline and candidate binaries.
run *args:
    uv run --locked --project {{quote(justfile_directory())}} --no-dev {{quote(justfile_directory() / "run.py")}} run {{args}}

# Check runner isolation and artifact-verification helpers.
test:
    #!/usr/bin/env bash
    set -euo pipefail
    uv run --locked --project {{quote(justfile_directory())}} --group test pytest {{quote(justfile_directory() / "run_test.py")}} -v
